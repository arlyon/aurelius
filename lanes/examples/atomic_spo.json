{
  "condition_predicates": ["operational_status"],
  "entity_anchors": {
    "source_record": "record",
    "report_schedule": "facet",
    "ranking_specification": "facet",
    "budget_plan": "facet",
    "campaign_activity": "facet",
    "tracking_configuration": "facet",
    "incident": "facet",
    "document": "mention",
    "person": "mention",
    "organization": "mention",
    "provider": "mention",
    "platform_account": "mention",
    "action": "action"
  },
  "facet_forms": {
    "report_schedule": ["report", "reporting", "stats"],
    "ranking_specification": ["ad groups", "headlines", "ranking"],
    "budget_plan": ["budget", "plan", "ramp"],
    "campaign_activity": ["campaign", "campaigns", "advertising", "ads"],
    "tracking_configuration": ["UTM", "UTMs", "tracking", "HubSpot"],
    "incident": ["issue", "incident", "duplicate", "duplicates", "missing"]
  },
  "predicates": {
    "pull_deadline": {"description": "Required or planned time to pull the scoped report; never its coverage period.", "subject_types": ["report_schedule"], "object": {"kind": "weekly_local_time"}, "render": "{subject} has pull deadline {object}"},
    "coverage_period": {"description": "The period covered by this report, not its pull deadline.", "subject_types": ["report_schedule"], "object": {"kind": "code", "parameters": {"prior_mon_sun": ["prior Mon-Sun", "previous Monday through Sunday", "prior Monday-Sunday"]}}, "render": "{subject} covers {object}"},
    "delivery_channel": {"description": "The source-declared channel for report delivery.", "subject_types": ["report_schedule"], "object": {"kind": "code", "parameters": {"slack": ["Slack"], "email": ["email"]}}, "render": "{subject} is delivered via {object}"},
    "delivery_recipient": {"description": "The recipient of the report, not its requester or executor.", "subject_types": ["report_schedule"], "object": {"kind": "entity", "parameters": ["person"]}, "render": "{subject} is delivered to {object}"},
    "ranking_metric": {"description": "The specific metric for a source-scoped ranking, not ownership of an agency/client metric.", "subject_types": ["ranking_specification"], "object": {"kind": "code", "parameters": {"form_fills": ["FORM FILLS", "form fills"], "ctr": ["CTR"]}}, "render": "{subject} is ranked by {object}"},
    "owned_by": {"description": "Explicit ownership of the referenced platform account, not tenant access, management or authorship.", "subject_types": ["platform_account"], "object": {"kind": "entity", "parameters": ["organization"]}, "render": "{subject} is owned by {object}"},
    "monthly_budget": {"description": "Explicit total monthly budget, never a delta, multi-month total or arithmetic derivation. Dollar symbols do not imply USD.", "subject_types": ["budget_plan"], "object": {"kind": "money"}, "render": "{subject} has monthly budget {object}"},
    "ramp_duration": {"description": "Explicit duration of the scoped plan's ramp; separate from budget amount.", "subject_types": ["budget_plan"], "object": {"kind": "duration"}, "render": "{subject} has ramp duration {object}"},
    "operational_status": {"description": "Status of scoped advertising activity or tracking, never the provider organization. Live status may also be an explicit conditional prerequisite.", "subject_types": ["campaign_activity", "tracking_configuration"], "object": {"kind": "code", "parameters": {"paused": ["paused", "pause"], "live": ["live"], "blocked": ["blocked"], "missing": ["missing", "don’t have utms", "don't have utms", "do not have utms"], "active": ["active"]}}, "render": "{subject} has operational status {object}"},
    "executor": {"description": "Source-assigned executor of a complete action, not its requester or recipient.", "subject_types": ["action"], "object": {"kind": "entity", "parameters": ["person"]}, "render": "{subject} has executor {object}"},
    "recipient": {"description": "Recipient of a complete action, separate from its executor.", "subject_types": ["action"], "object": {"kind": "entity", "parameters": ["person"]}, "render": "{subject} has recipient {object}"},
    "target": {"description": "Core target of an action; must also satisfy that action kind's target types.", "subject_types": ["action"], "object": {"kind": "entity", "parameters": ["document", "report_schedule", "platform_account", "campaign_activity", "tracking_configuration", "incident", "action"]}, "render": "{subject} targets {object}"}
  },
  "action_requirements": {
    "send": {"required_roles": ["executor", "target", "recipient"], "target_types": ["document", "report_schedule"], "verb_forms": ["send", "sending", "sent", "post", "posted"]},
    "update": {"required_roles": ["executor", "target"], "target_types": ["platform_account", "campaign_activity", "tracking_configuration"], "verb_forms": ["update", "updated", "change", "changed", "rebuild", "rebuilt"]},
    "investigate": {"required_roles": ["executor", "target"], "target_types": ["incident", "action", "tracking_configuration"], "verb_forms": ["investigate", "investigating", "review", "reviewed"]}
  }
}
